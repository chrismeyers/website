{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "warn"
    }
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "CI=true vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt '**/*.{ts,js,mjs,cjs}' && prettier --experimental-cli --write '**/*.astro'",
    "format:check": "oxfmt --check '**/*.{ts,js,mjs,cjs}' && prettier --experimental-cli --check '**/*.astro'",
    "check": "astro check",
    "dev": "astro dev",
    "generate": "bin/generate.sh",
    "prebuild": "npm run generate",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lightgallery": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "astro": "^7.2.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260804.1": true
  }
}
