{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "CI=true vitest run --coverage",
    "lint": "oxlint --type-aware -D warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --check '**/*.{ts,js,mjs,cjs}' && prettier --experimental-cli --check '**/*.astro'",
    "format:fix": "oxfmt '**/*.{ts,js,mjs,cjs}' && prettier --experimental-cli --write '**/*.astro'",
    "check": "astro check",
    "dev": "astro dev",
    "generate": "bin/generate.sh",
    "prebuild": "npm run generate",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lightgallery": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "astro": "^7.0.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.104.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260623.1": true
  }
}
